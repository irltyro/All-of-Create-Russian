	file.0000000000000001.title: " &6Всё о Create"
	quest.001201DAFCC3FAEC.title: "Выпей майонез"
	quest.0013FD56165BCB86.quest_desc: ["Внешний вид &6Водяного колеса&r можно изменить: щёлкни по нему правой кнопкой мыши, держа в руке практически любую &aдеревянную доску&r (в том числе из других модов)"]
	quest.0013FD56165BCB86.quest_subtitle: "Кинетический источник энергии, использующий поток &9воды&r. Он вырабатывает одинаковое количество &6SU&r при одинаковых &6об/мин&r, если рядом есть хотя бы один блок текущей &9воды&r"
	quest.002E6872C7B7AF76.title: "&eЛеденец"
	quest.006C2440BE69D73B.quest_subtitle: "Жидкое удобрение — новая жидкость, которая действует на блоки как костная мука"
	quest.006C2440BE69D73B.title: "&aЖидкое удобрение"
	quest.00735810B03E0333.title: "Испеки свою первую строопвафель"
	quest.008A7DD4311C72B0.title: "Создай &6механический пресс&r"
	quest.00A79CAA6844228D.title: "Получи пластик"
	quest.00F10FDD120BC630.quest_desc: ["Просто щёлкни правой кнопкой мыши по &6сливу для предметов&r с &6механическим точильным камнем&r в руке, затем поставь сверху ещё один такой блок — так можно измельчить зачарования и получить &aжидкий опыт&r."]
	quest.00F10FDD120BC630.quest_subtitle: "Станции для очистки &aинструментов и оружия&r от зачарований или &eполировки кварца&r"
	quest.00F10FDD120BC630.title: "&8Точильный камень и слив для предметов"
	quest.010925A7252F54C3.title: "Получи меч эха"
	quest.012266C464235C7F.title: "Собери материалы"
	quest.0145DD635CA8F16F.quest_subtitle: "Принимает входящий луч и &bполяризует его&r "
	quest.0145DD635CA8F16F.title: "&dПоглощающий поляризационный фильтр"
	quest.0148D094A35294EB.quest_subtitle: "Здесь понадобится либо удача, либо много тория"
	quest.014BDCB9922886EF.title: "&eКарамельный батончик"
	quest.01725D55B19D3E0F.quest_subtitle: "Эти блоки позволяют соединять &aшестерни цепями&r в сложных механизмах, где нужно, чтобы отдельные шестерни не взаимодействовали друг с другом"
	quest.01725D55B19D3E0F.title: "&6Фланцевые шестерни"
	quest.01AAA5D33720CE80.quest_subtitle: "&6Зачарователь ифритов&r — это умный стол зачарования&r, а &6кузница ифритов&r работает как умная наковальня. "
	quest.01AAA5D33720CE80.title: "&6Создай зачарователя ифритов и кузницу ифритов"
	quest.01C410421657C191.quest_subtitle: "Нажми &d\"R\"&r, чтобы посмотреть рецепты, и &d\"Z\"&r — чтобы узнать, как строить башни"
	quest.01C410421657C191.title: "Загрязнение"
	quest.0229FB3DD542C731.quest_subtitle: "&cРедстоуновое реле&r пропускает &6энергию&r, только получая сигнал &cредстоуна&r"
	quest.02903C6F107C8DA0.quest_subtitle: "Наконец-то — ядерная энергия"
	quest.02B0448DA14595B0.quest_subtitle: "&6Диаграмма механизма&r позволяет увидеть силы, действующие на присоединённый симулируемый механизм: &9гравитацию&r, &8сопротивление воздуха&r, &bлевитацию&r, &eподъёмную силу шаров&r, &6тягу&r, &aподъёмную силу&r и &dмагнитные&r силы"
	quest.02C47B1CE17E8DD5.quest_subtitle: "Ручные рукоятки с установленной шестернёй. Удобны для настройки передаточного отношения и работы в тесном пространстве"
	quest.02C47B1CE17E8DD5.title: "&6Большое кривошипное колесо"
	quest.02D5439ACE50EC34.quest_desc: ["Получается при &cобжиге&r или &cмассовом обжиге&r куска коксового угля"]
	quest.02D5439ACE50EC34.quest_subtitle: "Ещё более серьёзное улучшение"
	quest.02D5439ACE50EC34.title: "&7Очищенный коксовый уголь"
	quest.0335A87D46B28982.quest_subtitle: "Предмет для создания более совершенных механических компонентов"
	quest.035F309A9521A315.title: "Получи слиток &7стали&r"
	quest.0360911A620C6613.title: "&cКатушка-катализатор из розового кварца"
	quest.03795968E7FA18BA.quest_desc: [
		"Установи его. &eЩёлкни правой кнопкой мыши&r"
		"Теперь можно просматривать все магазины на сервере, историю цен, тренды и самых активных торговцев"
		""
		"Мод сканирует мир в поисках &6скатертей&r и &6торговых полок&r, превращая их в живой рынок, похожий на фондовую биржу. Интерфейс открывается через блок &6рыночного терминала&r"
	]
	quest.03795968E7FA18BA.quest_subtitle: "&6&lCreate: Stock Market&r превращает экономику сервера в живую биржу, которой управляют игроки"
	quest.03CD30560CC82ACC.quest_subtitle: "Мощность двигателя −20%, расход топлива −75% — для дальних поездок с минимальными затратами"
	quest.03CD30560CC82ACC.title: "&aВодяной двигатель"
	quest.046435AD378CE0C8.quest_subtitle: "Лучшие магниты в ассортименте, но стоят целое состояние"
	quest.04CE5B960FE826CA.quest_subtitle: "Если перед &6вентилятором в корпусе&r разместить &bогонь душ&r, вентилятор сможет подвергать предметы призрачной обработке"
	quest.04CEE0CA932DF671.quest_subtitle: "Это дополнение для Create добавляет предметы и рецепты, вводит новые &aисточники топлива для горелок ифритов&r и необычные способы организации паровых котлов&r. Хотелось бы иметь &bвозобновляемую альтернативу пирожным для ифритов&r? Теперь она есть!"
	quest.04CEE0CA932DF671.title: "&2Топливо для горелок ифритов"
	quest.04DA8B82DBFCA3D9.title: "Создай электрический насос"
	quest.0512ADDB7E6659CA.quest_desc: ["Получается, если спрессовать &aуголь&r, &aглиняный шарик&r и &aпшеницу&r с помощью &6механического пресса&r"]
	quest.0512ADDB7E6659CA.quest_subtitle: "Для изготовления брикетов "
	quest.0512ADDB7E6659CA.title: "&eСобери материалы"
	quest.05352FD080D95A2F.quest_desc: ["Нажми &eU&r, наведя курсор на &fсоломинку&r, чтобы посмотреть, какие жидкости она принимает и сколько они горят"]
	quest.05352FD080D95A2F.quest_subtitle: "Хотелось закачивать жидкости в &6горелки ифритов&r по трубам? Просто дай им &fсоломинку&r — и они будут втягивать жидкость прямо из трубы!"
	quest.053A085A1D02EEF0.quest_subtitle: "&6Водолазные ботинки&r позволяют ходить под водой так же, как по суше, а также стоять на конвейерных лентах, не сдвигаясь с места. Осторожно: прыгнув в океан, ты не всплывёшь!"
	quest.05422CBF447A8BB8.quest_desc: ["Получается, если уронить &6вал&r на &6механическую пилу&r"]
	quest.05422CBF447A8BB8.quest_subtitle: "Простой одноразовый соединитель для ранней стадии игры: ломается, если нагрузка на сеть становится слишком большой"
	quest.05422CBF447A8BB8.title: "&6Срезной штифт"
	quest.056C707476E4BA33.quest_subtitle: "Чтобы загружать топливо в загрузчик, понадобится что-то из этого"
	quest.056C707476E4BA33.title: "Загрузка топлива "
	quest.056C82BE2EB5AA4D.title: "Создай бумагу"
	quest.0573A08ED7C44CE6.title: "Построй &8дистилляционную башню&r"
	quest.05BC7CBC05B15830.quest_subtitle: "Передаёт тепло на небольшой участок. Не перегревай его…"
	quest.05C16E90B3E6304E.quest_desc: ["Для работы он должен вращаться со скоростью не менее &630 об/мин&r."]
	quest.05C16E90B3E6304E.quest_subtitle: "&6Механический смеситель&r может автоматически создавать предметы по shapeless-рецептам, а также смешивать, например, ингредиенты зелий"
	quest.0609D97DEB6E48BF.quest_subtitle: "&6Заключённая в корпус цепная передача&r позволяет получить несколько параллельных вращательных выходов и один раз изменить ось вращения"
	quest.06E1BE9BBC046094.quest_subtitle: "&6Механические уборщики&r позволяют механизмам собирать урожай"
	quest.071F9DA863D5E146.quest_subtitle: "Для начала нарежь хлеб на разделочной доске Farmer’s Delight или сделай булочку для бургера. Поставь станцию для сэндвичей, положи сверху ломтик хлеба или булочку и добавляй ингредиенты на свой вкус. Можно добавлять и зелья. Закончив, сломай сэндвич, чтобы забрать его. Чтобы разместить сэндвич где угодно, нажми Shift и щёлкни по блоку правой кнопкой мыши"
	quest.071F9DA863D5E146.title: "&eПриготовь &2сэндвич с курицей"
	quest.074A1D3CD1DAA784.title: "Получи слиток &6бронзы&r"
	quest.076C02684CB6D760.quest_subtitle: "Нажми &c\"Z\"&r, чтобы узнать, как это построить"
	quest.076C02684CB6D760.title: "Построй насос для сырой нефти"
	quest.07B2E02E2328F4C2.quest_subtitle: "&bВекторный двигатель&r — это направленный двигатель, который также может поворачиваться по рысканию и тангажу, обеспечивая векторное управление &6тягой&r"
	quest.07EC5E450BA9712D.quest_subtitle: "&6Плита&r — по сути, неподвижный конвейер"
	quest.081BC6F954D95C8A.quest_subtitle: "Кинетический источник, использующий силу ветра для создания вращения. Выработка &6SU&r зависит от числа парусов на &6ветряке&r и достигает максимума в 8192 SU на одну опору"
	quest.081BC6F954D95C8A.title: "Опора ветряка"
	quest.08D5EBEEC4FCBCD2.title: "&eВагонетка с воронкой"
	quest.08EA1AEF6AB1C266.quest_subtitle: "Это просто &6сиденье&r. Но если ты находишься на движущемся механизме, лучше приклеить его к механизму, чтобы перемещаться вместе с ним"
	quest.08EA1AEF6AB1C266.title: "&dСиденья"
	quest.0914B65F3F737825.title: "Создай аккумулятор"
	quest.092494276E7FD582.title: "&cАктивирующие рельсы"
	quest.094A700254F965DE.quest_subtitle: "&6Вентилятор в корпусе&r — универсальная машина: он может тянуть и толкать сущности, а также промывать, подвергать призрачной обработке, обжигать и коптить предметы"
	quest.095C1249FDE419C7.quest_subtitle: "Растопи моё сердце…"
	quest.095C1249FDE419C7.title: "Ой-ой!"
	quest.09F5744CA666F889.title: "Попробуй свои первые олиболлены"
	quest.0AC8942A131FCC34.quest_subtitle: "Объединяет до &aтрёх лучей в один&r, сочетая их свойства"
	quest.0AC8942A131FCC34.title: "&cКонденсатор лучей"
	quest.0AE0E5AA8FB69FE2.quest_subtitle: "Гаджеты на все случаи жизни"
	quest.0AE0E5AA8FB69FE2.title: "Добро пожаловать в Create: Connected"
	quest.0B75860976DB9B43.quest_subtitle: "&6Радиальное шасси&r — полезный блок для создания механизмов"
	quest.0BB0533CA61648D9.quest_subtitle: "Нажми &c\"Z\"&r, чтобы узнать, как это построить"
	quest.0BB0533CA61648D9.title: "Получи все двигатели и устрой настоящее бр-р-р-р"
	quest.0BBC18EB21B23D76.title: "Собери материалы и смешай их"
	quest.0BCAAE3D64E3FF14.quest_subtitle: "&6Расписание&r позволяет планировать движение поездов, чтобы ими могли управлять мобы или &6горелки ифритов&r"
	quest.0BD86E2C95C59E1B.title: "Создай амперметр и вольтметр"
	quest.0C15B829B4F22CF0.quest_desc: ["Получается, если пропустить &cмагматические блоки&r через пару &6дробящих колёс&r"]
	quest.0C15B829B4F22CF0.quest_subtitle: "Отличное и очень дешёвое топливо"
	quest.0C15B829B4F22CF0.title: "&cПылающие камни"
	quest.0C29CEB04D73AB53.quest_subtitle: "&6Сборщик физических механизмов&r используется для сборки и разборки симулируемых механизмов"
	quest.0C59E0866E7EFBF3.quest_subtitle: "&6Переносной интерфейс для жидкостей&r позволяет механизмам передавать жидкости блокам"
	quest.0CD9F34CBBCA3D44.title: "Получи медные листы"
	quest.0D04B64A3C45F2B6.title: "Создай поворотную опору"
	quest.0D49595D9B86A794.quest_desc: ["Запасись &cвёдрами лавы&r, чтобы никогда не остаться без &3топлива сверхвысокого нагрева&r"]
	quest.0D49595D9B86A794.quest_subtitle: "На вкус как Dr Pepper"
	quest.0D49595D9B86A794.title: "&aЗаполняем бак"
	quest.0D6431E6CC20CCC5.quest_subtitle: "Мощность двигателя +10% — когда нужно немного больше тяги"
	quest.0D6431E6CC20CCC5.title: "&aУкреплённые трубы"
	quest.0E1E056EBC1B0E57.title: "Заверни закуску в бумагу"
	quest.0E4024BDB0EE2BEA.title: "Зелье &4огнестойкости"
	quest.0E48DFA6774450FB.title: "Создай стеклянные панели"
	quest.0E4AC2D4FA50A4E2.quest_subtitle: "Дополнение к Create для создания собственных сэндвичей. Совместимо с Farmer’s Delight. Для начала построй станцию для сэндвичей"
	quest.0E4AC2D4FA50A4E2.title: "&eСоздай &2станцию для сэндвичей"
	quest.0EB48297625D6051.title: "Получи проволочную жилу из железа"
	quest.0ECF6A73AFA16B0D.quest_subtitle: "&6Шестерни&r позволяют повышать скорость вращения или расширять механизмы — в зависимости от ориентации. Поэкспериментируй с шестернями разных размеров и посмотри, что получится"
	quest.0ECF6A73AFA16B0D.title: "Шестерни"
	quest.0F1D3205FB83E2D3.quest_subtitle: "Можно найти во время охоты за сокровищами."
	quest.0F1D3205FB83E2D3.title: "&aСобери материалы и создай &3проводник"
	quest.0F2F0A538E65B228.quest_subtitle: "&cУмный наблюдатель&r может искать определённые предметы в мире или в инвентарях"
	quest.0F315FD3B94735A5.quest_subtitle: "&6Железнодорожная станция&r отвечает за сборку и разборку поездов"
	quest.0F76470B53D09466.title: "&eМедовая конфета"
	quest.0FCA9B992F6FC084.title: "Симуляция"
	quest.0FF39255BD5908AD.title: "Измельчи адский нарост, чтобы получить специи"
	quest.1042F8DDE3975030.quest_subtitle: "Клетка для проводника постепенно превратит его в призмариновые кристаллы"
	quest.1042F8DDE3975030.title: "&aПолучи &eсветящуюся пыль"
	quest.1047F4A424FF2A83.title: "Конденсатор высокого напряжения и переключатель"
	quest.1087DA469F3A10E8.title: "&eПриготовь &dторт со сладкими ягодами"
	quest.109DED9EC2176A5F.quest_subtitle: "Бесшовно &aперемещает&r предметы из одного контейнера в другой"
	quest.109DED9EC2176A5F.title: "&6Транспортёр"
	quest.10A822934956DF48.quest_subtitle: "Используется для создания нашего &dпоглощающего поляризационного фильтра"
	quest.10A822934956DF48.title: "&aПоляризационный фильтр"
	quest.10C57B245C83B5AA.title: "&5Светлая сторона"
	quest.10D7C5874FF7E693.quest_subtitle: "&6Наблюдатель за поездом&r выдаёт &cсигнал редстоуна&r, когда обнаруживает поезд"
	quest.10D7C5874FF7E693.title: "&dНаблюдатель за поездом"
	quest.1124C2ECF0808036.quest_subtitle: "Тяжёлый арбалет с мощным ударом; нужны стрелы"
	quest.1124C2ECF0808036.title: "&aТяжёлый арбалет"
	quest.116A74318FC9D231.title: "Создай сильно изолированный провод"
	quest.11EAA6665DE956FF.quest_subtitle: "&6Желоба&r используются для вертикальной передачи предметов между инвентарями: вниз под действием гравитации или вверх потоком воздуха от вентилятора в корпусе"
	quest.1209EAFCD7457303.quest_subtitle: "Используй &fсканер нефти&r, чтобы найти &8месторождения сырой нефти&r в моде &6Create Diesel Generators&r"
	quest.1283AD09A6377D92.title: "Получи шлак"
	quest.12BE6BEC1BC8A0CC.title: "Получи железную проволоку"
	quest.12D0B21E10AEEDB4.quest_desc: [
		"&cКинетическая батарея&r хранит &6единицы нагрузки&r на будущее. Благодаря ей можно обеспечить ограниченный запас &6единиц нагрузки&r, когда это необходимо, без необходимости каждый раз строить новую установку. Но прежде чем использовать блок, его нужно &cзарядить&r"
		""
		"&cКинетическая батарея&r заряжается, расходуя &6SU&r из подключённой сети, когда она &l&4выключена&r, и использует этот заряд, чтобы обеспечивать &6SU&r подключённой сети, когда она &2&lвключена&r "
	]
	quest.12D0B21E10AEEDB4.title: "&5Как зарядить кинетическую батарею"
	quest.12E775AF8E963543.quest_subtitle: "&7Пропеллер&r создаёт &6тягу&r при подаче питания"
	quest.13620647285BECBC.title: "Создай &7стальные трубы&r и &6умные трубы&r"
	quest.139DAA6E8CF4267A.quest_desc: [
		"Внизу инвентаря ты мог заметить строку поиска"
		""
		"Это строка поиска мода &dJust Enough Items&r, или &dJEI&r"
		""
		"Например, если ввести «Wood», &dJEI &rпокажет справа все предметы, в названии которых есть «Wood»"
		""
		"Если поставить @ в начале поискового запроса, отобразятся предметы из конкретного мода, например @Create"
		""
		"Чтобы добавить предмет в избранное, нажми &bA &r, наведя курсор на него в списке &dJEI &r. Он появится на левой панели, пока ты снова не нажмёшь &bA"
	]
	quest.139DAA6E8CF4267A.quest_subtitle: "Прочитай моё описание!"
	quest.139DAA6E8CF4267A.title: "&bJust Enough Items (JEI)"
	quest.13D833C11A71B131.quest_subtitle: "Можно использовать для питания &6кузницы ифритов&r и &6зачарователя ифритов&r"
	quest.13D833C11A71B131.title: "&2Блок опыта"
	quest.1498C78F14A0F91B.quest_subtitle: "Для установки колёс нужна &8опора колеса&r. Чтобы использовать её, &eщёлкни правой кнопкой мыши&r по опоре, держа любое колесо, — пружина автоматически подстроит размер"
	quest.14E0A5E1BA5DFA57.title: "Выработка тепла"
	quest.14F9238BF932A5EB.title: "&eПоймай курицу с помощью &bгнезда для птиц"
	quest.1524E0F8D079A605.title: "Создай окислитель топлива"
	quest.156DC76AB7CD1065.quest_subtitle: "&6Вал&r — ещё одна простая, но важная деталь механизма, необходимая для передачи вращения. Вал можно удлинить, чтобы он охватывал больше блоков в механизме, которым требуется вращение"
	quest.156DC76AB7CD1065.title: "Стержень постоянного вращения"
	quest.157DAE6EC4155F82.quest_subtitle: "Можно найти в &6пещерах&r."
	quest.157DAE6EC4155F82.title: "&aПолучи известняк"
	quest.15F53F788D18518A.title: "Организуй промышленный обжиг"
	quest.160E4D26B4D8A901.title: "Материалы для &3ящиков"
	quest.163364A51A8AC02E.quest_subtitle: "&8Камнерезное колесо&r быстро добывает блоки при вращении опорой &8буровой головки&r"
	quest.163D0CE9361628FA.title: "Двигатель"
	quest.1695EAB05715CDA0.title: "Создай катушку изолированного провода"
	quest.16C3EC6AE3C3F7C9.quest_desc: ["Теперь, когда всё необходимое создано, можно наконец изготовить комплект брони &3эха&r — мощную броню, дающую владельцу бесконечные эффекты &aсопротивления&r и &aсилы&r"]
	quest.16C3EC6AE3C3F7C9.title: "&bКомплект брони эха"
	quest.16C68DA939A28FCB.quest_subtitle: "Для создания неактивного ядра ифрита понадобятся механические сборщики"
	quest.16C68DA939A28FCB.title: "Активируй механический сборщик"
	quest.17336E4F60113C5C.title: "Собери цинковые самородки и выполни массовое промывание"
	quest.175099CF5696829E.quest_desc: [
		"&9Задачи &r— это действия, которые необходимо выполнить для завершения квеста. Если задача связана с предметом, щёлкни по ней, чтобы увидеть рецепт"
		""
		"&6Награды &r— это то, что ты получаешь после выполнения всех &9задач&r. Нажми, чтобы забрать награду"
		""
		"Значок булавки в левом верхнем углу позволяет закрепить квест на экране"
	]
	quest.175099CF5696829E.quest_subtitle: "Прочитай моё описание!"
	quest.175099CF5696829E.title: "&6Задания"
	quest.17E6DCDBEEBAEEAD.title: "&aВагонетка"
	quest.190FD2DF12D222C0.title: "&dПлитка шоколада с руби"
	quest.1970F0B8CFF70E5B.quest_subtitle: "Используй &6жернов&r, чтобы переработать &aизвестняк&r в &aподозрительные камни&r."
	quest.1970F0B8CFF70E5B.title: "&6Создай жернов"
	quest.19C5853C695A22A7.quest_subtitle: "&6Гаечный ключ&r позволяет мгновенно разрушать большинство блоков &6&lCreate&r с помощью &eShift + правого щелчка&r. Повернуть блок можно &eправым щелчком&r. Незаменимый инструмент, который всегда стоит держать при себе"
	quest.1A389BBE7CDB0F96.quest_subtitle: "&6Шланговый насос&r позволяет размещать или извлекать большие объёмы жидкости"
	quest.1A75654A3BC541AC.title: "Поймай разные виды рыб"
	quest.1A9BDF6B88E5A7A9.quest_desc: ["Получается при &cкопчении&r или &eмассовом копчении&r торфа"]
	quest.1A9BDF6B88E5A7A9.quest_subtitle: "Намного лучше угля и угольных брикетов"
	quest.1A9BDF6B88E5A7A9.title: "&aТорфяные брикеты "
	quest.1AFEF2789E7179B1.quest_subtitle: "&6Стрессометр&r показывает текущую нагрузку и запас допустимой нагрузки подключённой кинетической сети"
	quest.1B3F3097CE12FE41.quest_subtitle: "То, по чему ездят твои поезда"
	quest.1B3F3097CE12FE41.title: "Железнодорожный путь"
	quest.1B4EA9D4B62D0237.quest_subtitle: "&cРедстоуновый контакт&r выдаёт сигнал, соприкасаясь с другим &cредстоуновым контактом&r. Особенно полезен при создании механизмов"
	quest.1B67448AD335E5E4.quest_subtitle: "&8Опора буровой головки&r используется для создания буровых головок"
	quest.1B6AE2D9EE970BD3.quest_subtitle: "Фу-у-у!"
	quest.1B6AE2D9EE970BD3.title: "&dТорт эха"
	quest.1B7DD4402C5CD447.quest_desc: ["Получается, если использовать раздатчик с &eкремнём и огнивом&r и направить его на &aнеактивное ядро ифрита&r"]
	quest.1B7DD4402C5CD447.quest_subtitle: "Самый дорогой способ приготовить стейки"
	quest.1B7DD4402C5CD447.title: "&cЯдро ифрита"
	quest.1BAE590C1F42160D.quest_subtitle: "Нажми &c\"Z\"&r, чтобы узнать, как это построить"
	quest.1BAE590C1F42160D.title: "Построй дистилляционную башню"
	quest.1BDE6FE0A6240485.title: "Создай стальное и бронзовое снаряжение"
	quest.1BE274D820A20F49.title: "Получи смазку"
	quest.1BE84A67C4F49130.title: "&dОсколки аметиста"
	quest.1C709492F2F78BB9.quest_subtitle: "Прикрепи к любому инвентарю, чтобы увеличить его рабочую поверхность. Удобно в тесных местах и умных схемах с пороговыми переключателями. Предоставляет интерфейс для одновременного доступа к двум инвентарям и имеет слоты фильтров для быстрой сортировки входящих предметов"
	quest.1C709492F2F78BB9.title: "&aПорт доступа к инвентарю"
	quest.1C901D6957027EB8.quest_subtitle: "Добро пожаловать в Create: Kitchen! Этот набор модов включает три направления, которые помогут автоматизировать производство еды, приготовление блюд и фермерство"
	quest.1C901D6957027EB8.title: "&eДобро пожаловать в Create Kitchen"
	quest.1C982C9E827813C5.title: "Снаряжение для парусов"
	quest.1D0911E494CA0184.quest_subtitle: "&6Механическая рука&r — продвинутая машина для распределения предметов. Её настраивают на определённые блоки в пределах досягаемости; если рука не может дотянуться до места, она не сработает. Для работы требуются &6SU&r"
	quest.1D6E3B45533738C3.title: "Создай стальной механизм"
	quest.1D8DB9025EC63135.quest_subtitle: "&8Горелка горячего воздуха&r может получать сигнал &credstone&r и создавать &aподъёмную силу&r, наполняя воздушные шары горячим воздухом"
	quest.1D98174DC7159C28.quest_subtitle: "&cУправляемая защёлка&r переключает состояние при каждом импульсе редстоуна"
	quest.1DAB0F69BE29D8C5.quest_desc: ["Её также можно использовать для создания бесконечного источника &9воды&r, извлекая воду из блока-источника, рядом с которым находятся ещё два блока-источника"]
	quest.1DAB0F69BE29D8C5.quest_subtitle: "Поскольку большинство блоков в &6&lCreate&r не позволяют вручную извлекать и заливать жидкости, эти &6жидкостные трубы&r очень полезны"
	quest.1DAB0F69BE29D8C5.title: "Жидкостные трубы"
	quest.1E0AB71259E2B4DD.title: "Создай трансформатор тока"
	quest.1E3081292571CD31.title: "&cУспокаивающий горячий шоколад"
	quest.1E452DB4DCAD2939.title: "Получи сырую нефть"
	quest.1EA2D92981A22C95.title: "Создай &6бензиновый двигатель&r"
	quest.1EB883EB9A8A3785.title: "Установи &8качалку для нефти&r"
	quest.1EE4A5C43CE2B840.title: "&lПустой катализатор вентилятора"
	quest.1F091A899BB5622B.quest_subtitle: "Теперь пила больше никогда тебя не убьёт"
	quest.1F091A899BB5622B.title: "&d&lТотем бессмертия"
	quest.1F2EBB6012DD9278.title: "Собери припасы"
	quest.1F4456568BDB3EAD.quest_subtitle: "&6Управление механизмом&r позволяет отключать отдельные части механизма, пока он собран"
	quest.1FCEADEF0E5436BD.quest_subtitle: "Нажми &c\"Z\"&r, чтобы узнать, как это построить"
	quest.1FCEADEF0E5436BD.title: "Построй коксовую печь"
	quest.1FD4C31D8089C49C.title: "Создай рельсовый контакт и пантограф"
	quest.1FE0DB58676C394D.title: "Создай все улучшения для двигателей 1-го уровня"
	quest.1FE8EA6FB9329269.quest_desc: [
		"&b&lОсколок эха&r — первый шаг на пути к созданию чрезвычайно мощного &5оружия и &5брони&r, которые предоставляет Deep Dark&r."
		""
		"&l-&r Обычно его находят только в сундуках с добычей в &2древнем городе&r, но после множества проб и ошибок некоторые &6опытные священники&r научились синтезировать осколки на своих варочных стойках. Так можно избежать многих опасностей древних городов."
	]
	quest.1FE8EA6FB9329269.title: "&bОсколок эха"
	quest.1FFF9B91CA71694E.quest_subtitle: "Лава наносит небольшой урон от огня сущностям внизу в определённом радиусе"
	quest.1FFF9B91CA71694E.title: "&cВедро лавы"
	quest.2005366DA716D1AA.quest_desc: [
		"Самая долгая часть процесса — превращение &6незеритового слитка&r в &3&lслиток эха&r. Для этого нужно пять раз повторить следующую последовательность:"
		""
		"1&l-&r Вылить на него &cлаву&r"
		"2&l-&r Сплющить прессом"
		"3&l-&r Вылить на него немного &dрасплавленного эха&r"
		"4&l-&r Нанести на него &eпорошок ифрита&r"
		"5&l-&r И снова спрессовать"
		""
		"&c&nПовторить пять раз&r&r"
		""
		"Но после всех этих мучений у нас наконец окажется безупречный &3&lслиток эха&r"
	]
	quest.2005366DA716D1AA.title: "&l&9Слиток эха"
	quest.2005FA370149167D.quest_subtitle: "&6Слив для предметов&r позволяет вручную или автоматически извлекать жидкости из предметов"
	quest.2047D5978329D0AB.title: "Нефтяная качалка"
	quest.20D5607F60F7638A.title: "Создай электродвигатель"
	quest.2109B036CB2EB0D6.quest_subtitle: "Можно найти в Незере или изготовить"
	quest.2109B036CB2EB0D6.title: "Получи или создай магматический блок"
	quest.2165E80C52C79992.quest_desc: [
		"Нажми &bR &r, наведя курсор на предмет, чтобы посмотреть его рецепт"
		""
		"Нажми &bU &r, наведя курсор на предмет, чтобы посмотреть, где он используется"
		""
		"Нажми &bC &r, чтобы ползти"
		""
		"Нажми &bM &r, чтобы открыть карту мира"
		""
		"Нажми &bU &r, чтобы создать новую путевую точку"
		""
		"Нажми &bB &r, чтобы открыть рюкзак"
		""
